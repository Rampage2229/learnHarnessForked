# Personal fork — dev-run configuration (copy to .env.local; that file is gitignored).
# Point the dev server at your EXISTING app data dir so chats, graph, settings
# and keys carry over from the desktop AppImage installation:
LH_DATA_DIR=/home/rampj/.config/LearnHarness/data
LH_AUTH_FILE=/home/rampj/.config/LearnHarness/auth.json

# Dictation through the local Whisper bridge (extras/lh-whisper-bridge.py —
# the systemd service already runs it on this address):
LH_STT_BRIDGE_URL=ws://127.0.0.1:8765/v1/listen
